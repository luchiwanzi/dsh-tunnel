{
  "name": "@wanziya/dsh-tunnel",
  "version": "1.1.5",
  "type": "module",
  "description": "Subscription-driven outbound proxy for the agent runtime: local mihomo core, settings page, China-direct split routing, and Harness-scoped network routing.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "tunnel",
    "mihomo",
    "clash",
    "v2ray"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luchiwanzi/dsh-tunnel.git"
  },
  "homepage": "https://github.com/luchiwanzi/dsh-tunnel#readme",
  "bugs": {
    "url": "https://github.com/luchiwanzi/dsh-tunnel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@pkgship/mihomo": "1.19.33",
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
